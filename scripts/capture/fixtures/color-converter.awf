{
  "name": "Color Converter",
  "description": "Give it a hex color and get the matching RGB and HSL values back — handy for CSS and design work. Runs locally.",
  "tags": [
    "color",
    "css"
  ],
  "type": "triggered",
  "nodes": [
    {
      "id": "sticky-intro",
      "type": "stickyNote",
      "position": {
        "x": 20,
        "y": 20
      },
      "data": {
        "color": "#fff266",
        "content": "🎨 Convert a color.\n\nPress Run and enter a hex color like `#3b82f6` (3- or 6-digit, with or without the #). This flow converts it to RGB and HSL and shows all three formats. Everything runs locally in your browser."
      },
      "width": 360,
      "height": 190
    },
    {
      "id": "trigger-run",
      "type": "trigger",
      "position": {
        "x": 120,
        "y": 300
      },
      "data": {
        "instance": {
          "id": "af-base-node:trigger:whenStarted"
        },
        "label": "Run now",
        "inputs": {},
        "parameters": {
          "notes": "Starts the workflow when you press Run."
        }
      }
    },
    {
      "id": "ask-hex",
      "type": "inPageForm",
      "position": {
        "x": 440,
        "y": 300
      },
      "data": {
        "instance": {
          "id": "af-base-node:inPageForm:inPageForm"
        },
        "label": "Enter a hex color",
        "inputs": {
          "title": "Convert a color",
          "fields": [
            {
              "name": "hex",
              "label": "Hex color (e.g. #3b82f6)",
              "type": "text",
              "required": true
            }
          ]
        },
        "parameters": {
          "notes": "Collects the hex color you want to convert."
        }
      }
    },
    {
      "id": "convert",
      "type": "basic",
      "position": {
        "x": 760,
        "y": 300
      },
      "data": {
        "instance": {
          "id": "af-base-node:basic:code"
        },
        "label": "Convert hex → rgb → hsl",
        "inputs": {
          "code": "raw = (input.get('hex', '') if isinstance(input, dict) else str(input)).strip().lstrip('#')\nif len(raw) == 3:\n    raw = ''.join(c * 2 for c in raw)\ntry:\n    r = int(raw[0:2], 16); g = int(raw[2:4], 16); b = int(raw[4:6], 16)\n    ok = len(raw) == 6\nexcept Exception:\n    ok = False\nif not ok:\n    out = {'valid': False, 'error': 'Enter a valid 3- or 6-digit hex color, e.g. #3b82f6'}\nelse:\n    rf, gf, bf = r / 255.0, g / 255.0, b / 255.0\n    mx = max(rf, gf, bf); mn = min(rf, gf, bf); d = mx - mn\n    l = (mx + mn) / 2\n    if d == 0:\n        h = 0.0; s = 0.0\n    else:\n        s = d / (1 - abs(2 * l - 1))\n        if mx == rf:\n            h = ((gf - bf) / d) % 6\n        elif mx == gf:\n            h = (bf - rf) / d + 2\n        else:\n            h = (rf - gf) / d + 4\n        h *= 60\n    out = {\n        'valid': True,\n        'hex': '#' + raw.lower(),\n        'rgb': 'rgb(%d, %d, %d)' % (r, g, b),\n        'hsl': 'hsl(%d, %d%%, %d%%)' % (round(h), round(s * 100), round(l * 100))\n    }\nout"
        },
        "parameters": {
          "notes": "Python: parses the hex, then computes RGB and HSL. The last line is the result."
        }
      }
    },
    {
      "id": "show",
      "type": "basic",
      "position": {
        "x": 1080,
        "y": 300
      },
      "data": {
        "instance": {
          "id": "af-base-node:basic:displayMarkdownNode"
        },
        "label": "Show all formats",
        "inputs": {
          "title": "Color formats",
          "content": "**Hex:** `{{ $input.result.hex }}`\n\n**RGB:** `{{ $input.result.rgb }}`\n\n**HSL:** `{{ $input.result.hsl }}`\n\n> 💡 Paste the hex value into any editor's color picker to preview the swatch."
        },
        "parameters": {
          "notes": "Displays the hex, RGB, and HSL values with a note about previewing the swatch."
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-run-ask",
      "source": "trigger-run",
      "target": "ask-hex",
      "type": "flowEdge"
    },
    {
      "id": "e-ask-convert",
      "source": "ask-hex",
      "target": "convert",
      "type": "flowEdge"
    },
    {
      "id": "e-convert-show",
      "source": "convert",
      "target": "show",
      "type": "flowEdge"
    }
  ],
  "requiredInputs": []
}
