---
/**
 * Hero search box (Home.dc.html). Looks like an input that types example goals; clicking it opens
 * the docs search dialog (`data-awf-search-open`, handled by SearchDialog.svelte) and the dark
 * button opens its Ask Aria tab. Without JS the links fall back to Recipes and #ask-aria.
 * Under prefers-reduced-motion the first example is shown, static.
 */
const phrases = [
	'save this page to Notion',
	'watch a price for me',
	'summarise my unread emails',
	'fill this form from a sheet',
];
---

<div class="awh-ask awf-rise awf-d3">
	<a href="/recipes/" class="awh-ask__field" data-awf-search-open aria-label="Search the docs: what do you want to automate?">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
			><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
		>
		<span class="awh-ask__text" aria-hidden="true">
			<span class="awh-ask__prompt">What do you want to automate?</span>
			<span class="awh-ask__typed" data-awh-typer data-phrases={JSON.stringify(phrases)}>“{phrases[0]}”</span><span
				class="awh-caret"></span>
		</span>
	</a>
	<a href="#ask-aria" class="awh-ask__aria awf-press" data-awf-ask-aria>
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
			><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"></path></svg
		>
		Ask Aria
	</a>
</div>

<script>
	for (const el of document.querySelectorAll<HTMLElement>('[data-awh-typer]')) {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
		let phrases: string[] = [];
		try {
			phrases = JSON.parse(el.dataset.phrases ?? '[]');
		} catch {
			continue;
		}
		if (!phrases.length) continue;
		let p = 0;
		let n = 0;
		setInterval(() => {
			const full = phrases[p];
			if (n < full.length + 14) n++;
			else {
				p = (p + 1) % phrases.length;
				n = 0;
			}
			el.textContent = '“' + full.slice(0, Math.min(n, full.length)) + (n >= full.length ? '”' : '');
		}, 90);
	}
</script>
