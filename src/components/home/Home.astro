---
/**
 * Docs home (awflow/Agentic-Flow#1317, Home.dc.html): hero + live stage, fast path, section tiles,
 * works-with marquee, help strip and the footer links from #1323 (FAQ, Privacy & data).
 * The header, section tabs, search dialog and Ask Aria pill come from plugins/starlight-awflow.
 */
import { CHROME_WEB_STORE_URL, FIREFOX_ADDONS_URL } from '../../data/stores';
import { SECTION_PALETTE } from '../../../plugins/starlight-awflow/palette';
import { getHomeData } from './data';
import { useT } from '../../i18n/ui';
import { richParts } from '../../i18n/rich';
import HeroStage from './HeroStage.astro';
import SearchTyper from './SearchTyper.astro';
import './home.css';

const data = await getHomeData();
// The page sets `editUrl: false` so Starlight's own footer link doesn't duplicate this one.
const editUrl = 'https://github.com/agentic-com/Agentic-Flow-Doc/edit/Dev/src/content/docs/index.mdx';
const t = useT(Astro);

const explore = [
	{
		id: 'get-started',
		name: t('section.get-started'),
		href: t.href('/get-started/'),
		meta: t.plural('common.lessons', data.counts.getStarted),
		desc: t('home.tile.get-started'),
	},
	{
		id: 'app',
		name: t('section.app'),
		href: t.href('/app/'),
		meta: t.plural('home.meta.guides', data.counts.app),
		desc: t('home.tile.app'),
	},
	{
		id: 'recipes',
		name: t('section.recipes'),
		href: t.href('/recipes/'),
		meta: data.recipeCount ? t.plural('home.meta.recipes', data.recipeCount) : t('home.meta.byGoal'),
		desc: t('home.tile.recipes'),
	},
	{
		id: 'nodes',
		name: t('section.nodes'),
		href: t.href('/nodes/'),
		meta: t.plural('home.meta.nodes', data.nodeCount),
		desc: t('home.tile.nodes'),
	},
	{
		id: 'concepts',
		name: t('section.concepts'),
		href: t.href('/concepts/'),
		meta: t.plural('home.meta.pages', data.counts.concepts),
		desc: t('home.tile.concepts'),
	},
	{
		id: 'releases',
		name: t('section.releases'),
		href: t.href('/releases/'),
		meta: data.latest?.version ?? t('home.meta.changelog'),
		desc: t('home.tile.releases'),
	},
] as const;
const pressParts = richParts(t('home.fast.press'));
---

<div class="awh not-content" data-pagefind-ignore>
	<section class="awh-hero" aria-labelledby="awh-title">
		<div class="awh-hero__copy">
			<div class="awh-eyebrow awf-rise">
				<span class="awh-path">~/docs</span>
				{
					data.latest && (
						<a class="awh-new" href={t.href(data.latest.href)}>
							<span class="awh-new__pill awf-ping">{t('home.new')}</span>
							{t('home.whatsNew', { version: data.latest.version })}
							<span class="awf-arr" aria-hidden="true">
								→
							</span>
						</a>
					)
				}
			</div>
			<h1 id="awh-title" class="awh-title awf-rise awf-d1">
				{t('home.hero.l1')}<br /><span class="awh-shine">{t('home.hero.l2')}</span>
			</h1>
			<p class="awh-lede awf-rise awf-d2">
				{t('home.lede')}
			</p>
			<SearchTyper />
			<div class="awh-install awf-rise awf-d4">
				<a class="awh-btn awf-press" href={CHROME_WEB_STORE_URL}>{t('home.addChrome')}</a>
				{FIREFOX_ADDONS_URL && <a class="awh-btn awf-press" href={FIREFOX_ADDONS_URL}>{t('home.addFirefox')}</a>}
				<span class="awh-muted">{t('home.free')}</span>
			</div>
		</div>
		<div class="awh-hero__stage awf-rise awf-d2">
			<HeroStage />
		</div>
	</section>

	<section class="awh-section" aria-labelledby="awh-fast">
		<div class="awh-section__head">
			<h2 id="awh-fast">{t('home.fast.title')}</h2>
			<span class="awh-muted">
				{
					pressParts.map((p) =>
						p.kind === 'slot' && p.name === 'combo' ? (
							<Fragment>
								<kbd>⌘</kbd> <kbd>K</kbd>
							</Fragment>
						) : p.kind === 'slot' && p.name === 'slash' ? (
							<kbd>/</kbd>
						) : p.kind === 'text' ? (
							p.text
						) : null,
					)
				}
			</span>
		</div>
		<div class="awh-fast">
			<a
				class="awh-card awf-lift awf-rise awf-d1"
				style={`--c:${SECTION_PALETTE['get-started'].color};--tint-c:${SECTION_PALETTE['get-started'].tint}`}
				href={t.href('/app/chat-and-agents/building-workflows-in-chat/')}
			>
				<div class="awh-card__art awh-art-chat" aria-hidden="true">
					<span class="awh-bubble awh-bubble--me awh-log">{t('home.fast.chat.me')}</span>
					<span class="awh-bubble awh-log" style="animation-delay:1s">{t('home.fast.chat.aria')}</span>
				</div>
				<div class="awh-card__body">
					<span class="awh-card__title">{t('home.fast.aria.title')} <span class="awf-arr" aria-hidden="true">→</span></span>
					<span class="awh-card__desc">{t('home.fast.aria.desc')}</span>
					<span class="awh-card__meta">{t('home.fast.aria.meta')}</span>
				</div>
			</a>
			<a
				class="awh-card awf-lift awf-rise awf-d2"
				style={`--c:${SECTION_PALETTE.nodes.color};--tint-c:${SECTION_PALETTE.nodes.tint}`}
				href={t.href('/get-started/first-workflow/')}
			>
				<div class="awh-card__art awh-art-wire" aria-hidden="true">
					<span class="awh-mini awf-run"></span><span class="awf-wire"><i></i></span><span
						class="awh-mini awf-run awf-r2"></span><span class="awf-wire"><i style="animation-delay:.9s"></i></span><span
						class="awh-mini awh-mini--solid awf-run awf-r3"></span>
				</div>
				<div class="awh-card__body">
					<span class="awh-card__title">{t('home.fast.first.title')} <span class="awf-arr" aria-hidden="true">→</span></span>
					<span class="awh-card__desc">{t('home.fast.first.desc')}</span>
					<span class="awh-card__meta">{t('home.fast.first.meta')}</span>
				</div>
			</a>
			<a
				class="awh-card awf-lift awf-rise awf-d3"
				style={`--c:${SECTION_PALETTE.recipes.color};--tint-c:${SECTION_PALETTE.recipes.tint}`}
				href={t.href('/recipes/')}
			>
				<div class="awh-card__art awh-art-stack" aria-hidden="true">
					<span class="awh-sheet awf-float"></span>
					<span class="awh-sheet awh-sheet--front awf-float awf-f2">{t('home.fast.recipe.sheet')}</span>
				</div>
				<div class="awh-card__body">
					<span class="awh-card__title">{t('home.fast.recipe.title')} <span class="awf-arr" aria-hidden="true">→</span></span>
					<span class="awh-card__desc"
						>{data.recipeCount ? t.plural('home.fast.recipe.descCount', data.recipeCount) : t('home.fast.recipe.desc')}</span
					>
					<span class="awh-card__meta">{t('home.fast.recipe.meta')}</span>
				</div>
			</a>
		</div>
	</section>

	<section class="awh-section" aria-labelledby="awh-explore">
		<div class="awh-section__head">
			<h2 id="awh-explore">{t('home.explore')}</h2>
		</div>
		<div class="awh-explore">
			{
				explore.map((e) => (
					<a
						class="awh-tile awf-lift"
						href={e.href}
						style={`--c:${SECTION_PALETTE[e.id].color};--awf-tint:${SECTION_PALETTE[e.id].tint}`}
					>
						<div class="awh-tile__art" aria-hidden="true">
							<span class="awh-tile__box" />
							<span class="awh-tile__line" />
							<span class="awh-tile__node awf-float" />
							<span class="awh-tile__meta">{e.meta}</span>
						</div>
						<div class="awh-tile__body">
							<span class="awh-tile__name">
								{e.name} <span class="awf-arr" aria-hidden="true">→</span>
							</span>
							<span class="awh-tile__desc">{e.desc}</span>
							<span class="awh-sr">({e.meta})</span>
						</div>
					</a>
				))
			}
		</div>
	</section>

	<section class="awh-works" aria-labelledby="awh-works">
		<h2 id="awh-works" class="awh-works__label">
			{t.plural('home.works', data.appCount)}
		</h2>
		<div class="awh-marquee" tabindex="0" aria-label={t('home.marquee')}>
			<ul class="awh-marquee__track">
				{data.marquee.map((name) => <li>{name}</li>)}
				{
					data.marquee.map((name) => (
						<li aria-hidden="true" class="awh-marquee__dup">
							{name}
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="awh-help" aria-label={t('home.help')}>
		<a class="awh-help__card awh-help__card--dark awf-lift" href={t.href('/app/troubleshooting/')}>
			<span class="awh-help__tag">{t('home.help.fix.tag')}</span>
			<span class="awh-help__title">{t('home.help.fix.title')} <span class="awf-arr" aria-hidden="true">→</span></span>
			<span class="awh-help__desc">{t('home.help.fix.desc')}</span>
		</a>
		<a class="awh-help__card awf-lift" href={t.href('/app/privacy-and-data/')} style="--c:#92400E">
			<span class="awh-help__tag">{t('home.help.privacy.tag')}</span>
			<span class="awh-help__title">{t('home.help.privacy.title')} <span class="awf-arr" aria-hidden="true">→</span></span>
			<span class="awh-help__desc">{t('home.help.privacy.desc')}</span>
		</a>
		<a class="awh-help__card awf-lift" href={t.href('/app/help/help/')} style={`--c:${SECTION_PALETTE.releases.color}`}>
			<span class="awh-help__tag">{t('home.help.community.tag')}</span>
			<span class="awh-help__title">{t('home.help.community.title')} <span class="awf-arr" aria-hidden="true">→</span></span>
			<span class="awh-help__desc">{t('home.help.community.desc')}</span>
		</a>
	</section>

	<nav class="awh-foot" aria-label={t('home.foot.label')}>
		<span>{t('home.foot.copyright', { year: new Date().getFullYear() })}</span>
		<ul>
			<li><a href={t.href('/app/faq/')}>{t('home.foot.faq')}</a></li>
			<li><a href={t.href('/app/privacy-and-data/')}>{t('home.foot.privacy')}</a></li>
			<li><a href="/llms.txt">llms.txt</a></li>
			<li><a href="/releases/rss.xml">RSS</a></li>
			{editUrl && <li><a href={editUrl}>{t('home.foot.edit')}</a></li>}
		</ul>
	</nav>
</div>
