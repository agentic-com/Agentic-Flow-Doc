---
/**
 * Sidebar override (awflow/Agentic-Flow#1341): on `kind: lesson` pages, a learning-path rail
 * (level header, progress ring, the level's lessons with their done state, next-level card) sits
 * above the regular sidebar. Every other page renders the wrapped sidebar unchanged.
 *
 * The wrapped sidebar is whatever was registered before this plugin (starlight-sidebar-topics'
 * override here, or Starlight's default), exposed by index.ts as a virtual module.
 */
import Upstream from 'virtual:starlight-awflow/upstream-sidebar';
import { getCollection } from 'astro:content';
import { levelInfo } from '../lib/levels';

const route = Astro.locals.starlightRoute;
const data = route.entry.data as { kind?: string; lesson?: { level: number; order: number; minutes?: number } };
const current = data.kind === 'lesson' && data.lesson ? data.lesson : undefined;

let lessons: { id: string; href: string; title: string; order: number; minutes?: number }[] = [];
let level = current ? levelInfo(current.level) : undefined;
let nextLevel: ReturnType<typeof levelInfo> | undefined;

if (current) {
	const entries = await getCollection(
		'docs',
		(e) => (e.data as typeof data).kind === 'lesson' && (e.data as typeof data).lesson?.level === current.level,
	);
	lessons = entries
		.map((e) => {
			// The title, not the sidebar label: labels carry a "3 · " prefix the rail's dot already shows.
			const d = e.data as typeof data & { title: string };
			return {
				id: e.id,
				href: `/${e.id}/`,
				title: d.title,
				order: d.lesson!.order,
				minutes: d.lesson!.minutes,
			};
		})
		.sort((a, b) => a.order - b.order);
	const next = levelInfo(current.level + 1);
	if (!next.title.startsWith('Level ')) nextLevel = next;
}

const R = 20;
const C = +(2 * Math.PI * R).toFixed(2);
---

{
	current && level && (
		<nav class="awf-rail" aria-label="Learning path" data-awf-rail data-pagefind-ignore>
			<div class="awf-rail__head">
				<svg class="awf-rail__ring" width="56" height="56" viewBox="0 0 48 48" aria-hidden="true">
					<circle cx="24" cy="24" r={R} class="awf-rail__track" />
					<circle
						cx="24"
						cy="24"
						r={R}
						class="awf-rail__value"
						stroke-dasharray={C}
						stroke-dashoffset={C}
						transform="rotate(-90 24 24)"
						data-awf-ring
						data-circumference={C}
					/>
					<text x="24" y="28" text-anchor="middle" data-awf-ring-label>
						0%
					</text>
				</svg>
				<div class="awf-rail__title">
					<span class="awf-rail__eyebrow">Level {level.level}</span>
					<a href={level.href} class="awf-rail__name">
						{level.title}
					</a>
					<span class="awf-rail__note" data-awf-rail-note>
						<span data-awf-done-count>0</span> of {lessons.length} done · saved in this browser
					</span>
				</div>
			</div>
			<ol class="awf-rail__list">
				{lessons.map((l) => (
					<li>
						<a
							href={l.href}
							class="awf-rail__lesson"
							data-lesson-id={l.id}
							aria-current={l.order === current.order ? 'page' : undefined}
						>
							<span class="awf-rail__dot" aria-hidden="true">
								<span class="awf-rail__num">{l.order}</span>
								<span class="awf-rail__tick">✓</span>
							</span>
							<span class="awf-rail__label">
								{l.title}
								<span class="sr-only awf-rail__sr-done"> (done)</span>
							</span>
							{l.minutes && <span class="awf-rail__min">{l.minutes}m</span>}
						</a>
					</li>
				))}
			</ol>
			{nextLevel && (
				<a href={nextLevel.href} class="awf-rail__next">
					<span class="awf-rail__next-eyebrow">next · level {nextLevel.level}</span>
					<span class="awf-rail__next-title">{nextLevel.title} →</span>
				</a>
			)}
		</nav>
	)
}
<Upstream {...Astro.props}><slot /></Upstream>

<script>
	import { onLessonProgress } from '../lib/lesson-progress';

	for (const rail of document.querySelectorAll<HTMLElement>('[data-awf-rail]')) {
		const links = [...rail.querySelectorAll<HTMLAnchorElement>('[data-lesson-id]')];
		const ring = rail.querySelector<SVGCircleElement>('[data-awf-ring]');
		const label = rail.querySelector<SVGTextElement>('[data-awf-ring-label]');
		const count = rail.querySelector<HTMLElement>('[data-awf-done-count]');
		const c = Number(ring?.dataset.circumference ?? 125.66);
		onLessonProgress((done) => {
			let n = 0;
			for (const a of links) {
				const isDone = done.has(a.dataset.lessonId ?? '');
				a.classList.toggle('is-done', isDone);
				if (isDone) n++;
			}
			const pct = links.length ? Math.round((n / links.length) * 100) : 0;
			ring?.setAttribute('stroke-dashoffset', String(c * (1 - n / Math.max(links.length, 1))));
			if (label) label.textContent = `${pct}%`;
			if (count) count.textContent = String(n);
		});
	}
</script>

<style>
	.awf-rail {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-bottom: 1.25rem;
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--sl-color-hairline);
	}
	.awf-rail__head {
		display: flex;
		align-items: center;
		gap: 0.875rem;
	}
	.awf-rail__ring {
		flex: none;
	}
	.awf-rail__track {
		fill: none;
		stroke: var(--awf-line-soft, #f0e9df);
		stroke-width: 5;
	}
	.awf-rail__value {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 5;
		stroke-linecap: round;
		transition: stroke-dashoffset 0.8s var(--awf-ease, ease);
	}
	.awf-rail__ring text {
		font-size: 12px;
		font-weight: 700;
		fill: var(--sl-color-white);
		font-family: var(--sl-font);
	}
	.awf-rail__title {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		min-width: 0;
	}
	.awf-rail__eyebrow,
	.awf-rail__min,
	.awf-rail__next-eyebrow {
		font-family: var(--sl-font-mono);
		font-size: 0.6875rem;
	}
	.awf-rail__eyebrow {
		color: var(--sl-color-text-accent);
		text-transform: lowercase;
	}
	.awf-rail__name {
		font-weight: 650;
		color: var(--sl-color-white);
		text-decoration: none;
		line-height: 1.3;
	}
	.awf-rail__name:hover {
		color: var(--sl-color-text-accent);
	}
	.awf-rail__note {
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
	}
	.awf-rail__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}
	.awf-rail__lesson {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.5rem 0.625rem;
		border-radius: 12px;
		font-size: 0.875rem;
		line-height: 1.35;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		transition:
			background var(--awf-fast, 150ms),
			transform var(--awf-fast, 150ms);
	}
	.awf-rail__lesson:hover {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
		transform: translateX(2px);
	}
	.awf-rail__lesson[aria-current='page'] {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-text-accent);
		font-weight: 600;
	}
	.awf-rail__dot {
		flex: none;
		width: 1.625rem;
		height: 1.625rem;
		border-radius: 999px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.75rem;
		font-weight: 700;
		background: var(--awf-surface-2, #f0e9df);
		color: var(--sl-color-gray-3);
	}
	.awf-rail__lesson[aria-current='page'] .awf-rail__dot {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	:root[data-theme='light'] .awf-rail__lesson[aria-current='page'] .awf-rail__dot {
		color: #fff;
	}
	.awf-rail__tick,
	.awf-rail__sr-done {
		display: none;
	}
	.awf-rail__lesson.is-done .awf-rail__dot {
		background: #dcfce7;
		color: #166534;
	}
	.awf-rail__lesson.is-done .awf-rail__num {
		display: none;
	}
	.awf-rail__lesson.is-done .awf-rail__tick {
		display: inline;
	}
	.awf-rail__lesson.is-done .awf-rail__sr-done {
		display: inline;
	}
	.awf-rail__label {
		flex: 1;
		min-width: 0;
	}
	.awf-rail__min {
		color: var(--sl-color-gray-3);
		font-weight: 400;
	}
	.awf-rail__next {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.875rem;
		border-radius: 14px;
		background: #1c1917;
		color: #fafaf9;
		text-decoration: none;
		transition: transform var(--awf-fast, 150ms);
	}
	:root:not([data-theme='light']) .awf-rail__next {
		background: var(--awf-surface-2, #292420);
		border: 1px solid var(--awf-line, #3a332e);
	}
	.awf-rail__next:hover {
		transform: translateY(-1px);
		color: #fafaf9;
	}
	.awf-rail__next-eyebrow {
		color: #fbbf24;
	}
	.awf-rail__next-title {
		font-weight: 600;
	}
	@media (prefers-reduced-motion: reduce) {
		.awf-rail__value,
		.awf-rail__lesson,
		.awf-rail__next {
			transition: none;
		}
		.awf-rail__lesson:hover,
		.awf-rail__next:hover {
			transform: none;
		}
	}
</style>
