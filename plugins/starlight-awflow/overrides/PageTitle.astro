---
/**
 * PageTitle override.
 * - `kind: node` → node header (icon, family, Works-in, agent tool, page actions).
 * - a resolvable section → coloured section banner with a dashed wireframe.
 * - otherwise → Starlight's default title.
 * Every variant keeps `<h1 id="_top">` so the skip link and "Overview" TOC entry keep working.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { getAwflowRoute } from '../route-data';
import NodeHeader from '../components/NodeHeader.astro';
import SectionBanner from '../components/SectionBanner.astro';
import { useT } from '../../../src/i18n/ui';

const awflow = getAwflowRoute(Astro.locals);
const { showBanner, node, section } = awflow;
const t = useT(Astro);
---

{
	node ? (
		<NodeHeader />
	) : showBanner && section ? (
		<SectionBanner />
	) : (
		<Default {...Astro.props}>
			<slot />
		</Default>
	)
}

{
	awflow.i18n?.stale && (
		<p class="awf-stale" data-pagefind-ignore>
			{t('i18n.stale')} <a href={awflow.i18n.englishHref} hreflang="en">{t('i18n.readEnglish')}</a>
		</p>
	)
}
