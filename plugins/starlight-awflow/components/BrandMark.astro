---
/** The node-pair mark: two nodes joined by a wire. Decorative; the link around it carries the name. */
interface Props {
	size?: number;
}
const { size = 30 } = Astro.props;
---

<svg class="awf-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
	<rect width="32" height="32" rx="9" fill="#B45309"></rect>
	<rect x="5" y="6" width="10" height="8" rx="2.5" fill="#FFF3E3"></rect>
	<rect x="17" y="18" width="10" height="8" rx="2.5" fill="#FFF3E3"></rect>
	<path d="M15 10h2.5a3.5 3.5 0 0 1 3.5 3.5V18" stroke="#FFF3E3" stroke-width="2" fill="none" stroke-linecap="round"
	></path>
</svg>
